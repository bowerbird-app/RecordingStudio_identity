<% dummy_page_nav(title: "Identities", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Identities",
    subtitle: "One identity, many identities, a nested parent, and configurable creation text.",
    variant: :h1
  ) %>

  <div class="grid gap-6 lg:grid-cols-2">
    <%= render "example",
          title: "One identity",
          body: "A workspace holds a single identity. A trashed identity keeps the slot until it is restored or purged.",
          href: (@studio && recording_studio_identity.recording_identities_path(@studio)) %>
    <%= render "example",
          title: "Many identities",
          body: "An agency lists every identity it holds and can add another.",
          href: (@agency && recording_studio_identity.recording_identities_path(@agency)) %>
    <%= render "example",
          title: "Nested parent",
          body: "A project under a workspace holds its own identities.",
          href: (@project && recording_studio_identity.recording_identities_path(@project)) %>
    <%= render "example",
          title: "Creation text",
          body: "The category screen uses the host title, description, and Continue label.",
          href: (@agency && recording_studio_identity.new_recording_identity_path(@agency)) %>
  </div>
</div>
