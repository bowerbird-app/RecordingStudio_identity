<%# locals: (title:, body:, href:) %>
<%= render FlatPack::Card::Component.new(border: :default, shadow: :none) do |card| %>
  <% card.header do %>
    <%= render FlatPack::PageTitle::Component.new(title: title, variant: :h3, class: "mb-0 pb-0") %>
  <% end %>
  <% card.body do %>
    <p class="text-sm leading-6"><%= body %></p>
  <% end %>
  <% if href %>
    <% card.footer do %>
      <%= render FlatPack::Button::Component.new(text: "Open", style: :primary, href: href) %>
    <% end %>
  <% end %>
<% end %>
