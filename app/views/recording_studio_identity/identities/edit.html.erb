<% name = @identity.recordable.name %>
<% recording_studio_page_nav(
  title: t("recording_studio.identity.titles.edit_with_name", name: name),
  page_nav_back_url: identity_path(@identity),
  page_nav_back_label: t("recording_studio.identity.navigation.back")
) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: t("recording_studio.identity.titles.edit"),
    subtitle: identity_category_label(@identity)
  ) %>
  <%= render "image_field", identity: @identity, category: @category, standalone: true %>

  <%= render "form",
        record: @record,
        category: @category,
        identity: @identity,
        url: identity_path(@identity),
        form_method: :patch,
        submit_text: t("recording_studio.identity.actions.save"),
        cancel_url: identity_path(@identity),
        unsaved_changes: true,
        delete_url: identity_path(@identity) %>
</div>
