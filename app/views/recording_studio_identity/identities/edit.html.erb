<% name = @identity.recordable.name %>
<% recording_studio_page_nav(
  title: identity_t("titles.edit_with_name", name: name),
  page_nav_back_url: identity_path(@identity),
  page_nav_back_label: identity_t("navigation.back")
) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: identity_t("titles.edit"),
    subtitle: identity_category_label(@identity)
  ) %>
  <%= render "form",
        record: @record,
        category: @category,
        identity: @identity,
        url: identity_path(@identity),
        form_method: :patch,
        submit_text: identity_t("actions.save"),
        cancel_url: identity_path(@identity),
        unsaved_changes: true,
        delete_url: identity_path(@identity),
        include_image: true %>
</div>
