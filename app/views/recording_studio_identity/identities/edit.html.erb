<% content_for :title, identity_t("titles.edit") %>
<% content_for :subtitle, identity_category_label(@identity) %>
<% flat_pack_page_nav(
  round: true,
  style: :default,
  back_href: identity_path(@identity),
  back_tooltip: identity_t("navigation.back")
) %>

<div class="flex w-full flex-col gap-6">
  <%= render "form",
        record: @record,
        category: @category,
        identity: @identity,
        url: identity_path(@identity),
        form_method: :patch,
        submit_text: identity_t("actions.save"),
        cancel_url: identity_path(@identity),
        unsaved_changes: true,
        delete_url: identity_path(@identity),
        include_image: true %>
</div>
