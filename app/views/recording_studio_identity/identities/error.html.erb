<% content_for :title, @error_title %>
<% if (home_path = identity_home_path) %>
  <% flat_pack_page_nav(
    round: true,
    style: :default,
    back_href: home_path,
    back_tooltip: identity_t("navigation.home")
  ) %>
<% end %>

<%= render FlatPack::Alert::Component.new(style: :danger, title: @error_title, description: @error_description) %>
