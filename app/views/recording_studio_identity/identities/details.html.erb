<% content_for :title, identity_t("titles.add") %>
<% content_for :subtitle, @category&.label %>
<% flat_pack_page_nav(
  round: true,
  style: :default,
  back_href: (@categories.one? ? recording_identities_path(@parent) : new_recording_identity_path(@parent)),
  back_tooltip: identity_t("navigation.back")
) %>

<div class="flex w-full flex-col gap-6">
  <%= render "form",
        record: @record,
        category: @category,
        url: recording_identities_path(@parent),
        form_method: :post,
        submit_text: identity_t("actions.save"),
        cancel_url: recording_identities_path(@parent),
        idempotency_key: @idempotency_key,
        include_image: true %>
</div>
