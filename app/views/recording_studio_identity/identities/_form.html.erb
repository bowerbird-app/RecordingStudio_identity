<%# locals: (record:, category:, url:, form_method:, submit_text:, cancel_url:, idempotency_key: nil, unsaved_changes: false, delete_url: nil, identity: nil) %>
<% limits = RecordingStudioIdentity::Identity::LIMITS %>
<% form_data = unsaved_changes ? { controller: "flat-pack--unsaved-changes" } : {} %>
<%= form_with url: url, method: form_method, class: "flex max-w-2xl flex-col gap-4", data: form_data do %>
  <% if idempotency_key %>
    <%= hidden_field_tag :idempotency_key, idempotency_key, id: nil %>
  <% end %>
  <% if record.kind.present? && form_method.to_s == "post" %>
    <%= hidden_field_tag "identity[kind]", record.kind, id: nil %>
  <% end %>

  <% if record.errors.any? %>
    <%= render FlatPack::Alert::Component.new(
      style: :danger,
      title: t("recording_studio.identity.form.save_failed_title"),
      description: record.errors.full_messages.map { |message|
        RecordingStudioIdentity::Copy.user_message(message)
      }.to_sentence
    ) %>
  <% end %>

  <%= render "image_field", identity: identity, category: category %>

  <%= render FlatPack::TextInput::Component.new(
    name: "identity[name]",
    value: record.name,
    label: identity_field_label(category, :name),
    required: true,
    maxlength: limits[:name],
    error: identity_field_error(record, :name)
  ) %>

  <%= render FlatPack::TextArea::Component.new(
    name: "identity[description]",
    value: record.description,
    label: identity_field_label(category, :description),
    rows: 4,
    maxlength: limits[:description],
    error: identity_field_error(record, :description)
  ) %>

  <%= render FlatPack::UrlInput::Component.new(
    name: "identity[website_url]",
    value: record.website_url,
    label: identity_field_label(category, :website_url),
    placeholder: t("recording_studio.identity.placeholders.website"),
    maxlength: limits[:website_url],
    error: identity_field_error(record, :website_url)
  ) %>

  <div class="flex flex-wrap items-center gap-3">
    <% if unsaved_changes %>
      <%= render FlatPack::Button::Component.new(
        text: submit_text,
        style: :default,
        type: "submit",
        data: { "flat-pack--unsaved-changes-target": "submit" }
      ) %>
    <% else %>
      <%= render FlatPack::Button::Component.new(text: submit_text, style: :primary, type: "submit") %>
    <% end %>
    <%= render FlatPack::Button::Component.new(
      text: t("recording_studio.identity.actions.cancel"),
      style: :ghost,
      href: cancel_url
    ) %>
    <% if delete_url %>
      <%= render FlatPack::Button::Component.new(
        text: t("recording_studio.identity.actions.delete"),
        style: :danger,
        type: "submit",
        form: "delete-identity",
        class: "ml-auto"
      ) %>
    <% end %>
  </div>
<% end %>
<% if delete_url %>
  <%= form_with url: delete_url, method: :delete, id: "delete-identity", class: "hidden" do %>
  <% end %>
<% end %>
