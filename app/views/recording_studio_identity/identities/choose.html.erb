<% creation = RecordingStudioIdentity.creation %>
<% content_for :title, creation.title %>
<% flat_pack_page_nav(
  round: true,
  style: :default,
  back_href: recording_identities_path(@parent),
  back_tooltip: identity_t("navigation.back")
) %>

<div class="flex w-full max-w-3xl flex-col gap-6">
  <% if @unknown_kind %>
    <%= render FlatPack::Alert::Component.new(
      style: :danger,
      title: identity_t("form.save_failed_title"),
      description: "Choose one of the configured categories."
    ) %>
  <% end %>

  <%= form_with url: new_recording_identity_path(@parent), method: :get, class: "flex flex-col gap-4" do %>
    <%= render FlatPack::RadioGroup::Component.new(
      name: "kind",
      label: creation.title,
      hide_label: true,
      variant: :cards,
      align: :start,
      columns: 2,
      required: true,
      options: @categories.map { |category|
        {
          label: category.label,
          value: category.key,
          icon: category.icon_name,
          description: category.description
        }
      }
    ) %>

    <%= render FlatPack::Button::Component.new(
      text: creation.continue_label,
      style: :primary,
      type: "submit",
      class: "mt-6 w-full"
    ) %>
  <% end %>
</div>
