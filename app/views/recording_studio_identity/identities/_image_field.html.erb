<%# locals: (identity:, category:, removable: false) %>
<% image = identity && RecordingStudioIdentity.image(identity) %>
<% label = identity_field_label(category, :image) %>
<% button_text = image ? t("recording_studio.identity.actions.change_image") : t("recording_studio.identity.actions.upload_image") %>

<div class="flex flex-col gap-3" data-testid="identity-image-field">
  <span class="text-sm font-medium"><%= label %></span>
  <div class="flex flex-wrap items-center gap-4">
    <% if identity %>
      <%= recording_studio_identity_image(identity, size: :xl, shape: :circle) %>
    <% end %>

    <div class="inline-flex flex-col gap-2">
      <%= hidden_field_tag "image[signed_blob_id]", "",
            id: nil,
            data: { recording_studio_attachable__attachment_revision_upload_target: "signedBlobInput" } %>
      <input type="file"
             class="hidden"
             accept="<%= identity_image_accept %>"
             aria-label="<%= label %>"
             data-recording-studio-attachable--attachment-revision-upload-target="fileInput"
             data-action="change->recording-studio-attachable--attachment-revision-upload#fileSelected">
      <%= render FlatPack::Button::Component.new(
        text: button_text,
        style: :secondary,
        type: "button",
        data: { action: "recording-studio-attachable--attachment-revision-upload#browse" }
      ) %>
      <p class="hidden text-sm text-(--surface-muted-content-color)"
         data-recording-studio-attachable--attachment-revision-upload-target="status"></p>
    </div>

    <% if removable %>
      <%= render FlatPack::Button::Component.new(
        text: t("recording_studio.identity.actions.remove_image"),
        style: :ghost,
        type: "submit",
        form: "remove-identity-image"
      ) %>
    <% end %>
  </div>
</div>
