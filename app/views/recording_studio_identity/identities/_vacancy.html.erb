<%# locals: (parent:, identity:) %>
<% if identity&.trashed_at %>
  <%= render FlatPack::Alert::Component.new(
    style: :warning,
    title: t("recording_studio.identity.trash.in_trash_title", name: identity.recordable.name),
    description: t(
      "recording_studio.identity.trash.vacancy_description",
      type: identity_recording_type_label(parent).downcase,
      name: identity.recordable.name
    )
  ) %>
  <% if identity_can?(:restore, identity) %>
    <%= form_with url: restore_identity_path(identity), method: :post, class: "inline-flex" do %>
      <%= render FlatPack::Button::Component.new(
        text: t("recording_studio.identity.actions.restore_identity"),
        style: :primary,
        type: "submit"
      ) %>
    <% end %>
  <% end %>
<% else %>
  <%= render FlatPack::EmptyState::Component.new(
    title: t("recording_studio.identity.empty.no_identity_title"),
    description: t("recording_studio.identity.empty.no_identity_description", type: identity_recording_type_label(parent).downcase),
    icon: :user
  ) %>
<% end %>
